# Database Configuration (Defaults to embedded SQLite out-of-the-box)
DATABASE_URL=sqlite:///./ecogenius.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ecogenius

# AI Provider Configuration (Optional: Defaults to built-in MockAIProvider analytical engine if empty)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Server Configuration
PORT=8000
FRONTEND_PORT=3000
